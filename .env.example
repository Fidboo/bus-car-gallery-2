# Copy these into the host's "Environment" settings (never commit real values).

# --- Required in production ---------------------------------------------
SECRET_KEY=paste-a-long-random-string-here          # python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_PASSWORD_HASH='paste-output-of-tools/make_password_hash.py'   # keep the single quotes in a shell

# Folder for the database (a persistent disk on the host)
DATA_DIR=/var/data

# --- Cloudflare R2 (photo storage) --------------------------------------
R2_BUCKET=bus-gallery
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_PUBLIC_URL=https://billeder.dit-domaene.dk

# --- Behind Cloudflare ----------------------------------------------------
TRUST_CLOUDFLARE=1
ORIGIN_SECRET=another-long-random-string            # optional but recommended, see OPSAETNING.md

# --- Optional -------------------------------------------------------------
CONTACT_EMAIL=
MAX_UPLOAD_MB=50
